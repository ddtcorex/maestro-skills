# OS cruft
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*~

# Build outputs & dependencies
node_modules/
lib/
*.tsbuildinfo

# Personal Claude Code plugin settings (see plugin-settings convention)
.claude/*.local.md

# Force-track agent instruction files even if a global core.excludesFile rule excludes them
!AGENTS.md
!CLAUDE.md

# The global gitignore hides docs/superpowers to keep in-progress specs out of
# sub-repos; this repo commits shipped design records there (see AGENTS.md).
!docs/superpowers
